          <MoneyInput id="paidPension" label="국민연금 본인 부담액 (연 합계)" value={null} placeholder="비우면 추정해요" hint="급여명세서의 국민연금을 12개월 합친 금액이에요." />
          <MoneyInput id="paidHealth" label="건강·장기요양·고용보험 본인 부담액 (연 합계)" value={null} placeholder="비우면 추정해요" hint="세 가지를 모두 합친 연간 금액이에요." />
