---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Section from '../../components/ui/Section.astro';
import MoneyInput from '../../components/ui/MoneyInput.astro';
import Chips from '../../components/ui/Chips.astro';
import Stepper from '../../components/ui/Stepper.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Details from '../../components/ui/Details.astro';
import Button from '../../components/ui/Button.astro';
import ResultHero from '../../components/ui/ResultHero.astro';
import ResultTable from '../../components/ui/ResultTable.astro';
import StickyResultBar from '../../components/ui/StickyResultBar.astro';
import CopyButton from '../../components/ui/CopyButton.astro';
import ShareButton from '../../components/ui/ShareButton.astro';
import Toast from '../../components/ui/Toast.astro';
import AdSlot from '../../components/ui/AdSlot.astro';
import Steps from '../../components/ui/Steps.astro';
import DataTable from '../../components/ui/DataTable.astro';
import SourceList from '../../components/ui/SourceList.astro';
import Notice from '../../components/ui/Notice.astro';
import FaqList from '../../components/ui/FaqList.astro';
import ToolCard from '../../components/ui/ToolCard.astro';
import ChangeLog from '../../components/ui/ChangeLog.astro';
import RotateCcw from '../../components/icons/RotateCcw.astro';
import Check from '../../components/icons/Check.astro';
import Info from '../../components/icons/Info.astro';
import ExternalLink from '../../components/icons/ExternalLink.astro';
import { SITE_NAME, SITE_URL, TOOLS, getCategory } from '../../config';
import { calculateYearEnd } from '../../lib/year-end-tax';
import { YEAR_END_DEFAULTS } from '../../lib/year-end-query';
import { viewOf, hintsOf, YE_ROWS, YE_TOTAL_ROWS } from '../../lib/year-end-view';
import { won, koreanAmount } from '../../lib/format';
import { INCOME_TAX } from '../../data/payroll';
import {
  YE_BASE_YEAR, YE_AS_OF, YE_SOURCES, CARD, PERSONAL, CHILD_CREDIT, PENSION_ACCOUNT, SPECIAL_CREDIT, RENT_CREDIT, STANDARD_CREDIT, MARRIAGE_CREDIT,
} from '../../data/year-end-tax-2026';

const tool = TOOLS.find((t) => t.slug === 'year-end-tax')!;
const salaryTool = TOOLS.find((t) => t.slug === 'salary')!;
const taxCat = getCategory('tax');
const d = YEAR_END_DEFAULTS;
const initial = calculateYearEnd(d);
const view = viewOf(initial, d);
const hints = hintsOf(initial, d);
const out = view.out;

const title = `연말정산 계산기 (${YE_BASE_YEAR}년 귀속)`;
const description = `연봉과 카드 사용액, 가족, 공제 항목을 넣으면 ${YE_BASE_YEAR}년 귀속 연말정산 예상 환급액이나 추가 납부액을 바로 알려드려요. 계산 순서와 기준값을 공개해요.`;
const man = (n: number) => `${(n / 10_000).toLocaleString('ko-KR')}만 원`;
const pct = (n: number) => `${+(n * 100).toFixed(1)}%`;

const rowOf = (def: { key: string; label: string }) => ({ key: def.key, label: def.label, ...view.rows[def.key] });

/* ---------- 예시 3건 ---------- */
const examples = [
  { name: '예시 1', desc: '연봉 3,000만 원, 혼자, 자녀 없음', input: { ...d, annualSalary: 30_000_000 } },
  { name: '예시 2', desc: '연봉 5,000만 원, 가족 4명(자녀 2명), 카드 많이 사용', input: { ...d, annualSalary: 50_000_000, dependents: 4, children: 2, cardCredit: 20_000_000, cardDebit: 10_000_000, cardMarket: 500_000, cardTransit: 1_200_000 } },
  { name: '예시 3', desc: '연봉 7,000만 원, 혼자, 연금저축 600만 원', input: { ...d, annualSalary: 70_000_000, pensionSaving: 6_000_000 } },
].map((e) => ({ ...e, r: calculateYearEnd(e.input) }));
const signed = (n: number) => (n === 0 ? won(0) : `${n < 0 ? '환급 ' : '추가 납부 '}${won(Math.abs(n))}`);
const exampleRows = [
  { item: '조건', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, e.desc])) },
  { item: '총급여', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, won(e.r.totalSalary)])) },
  { item: '카드 소득공제', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, won(e.r.cardDeduction)])) },
  { item: '과세표준', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, won(e.r.taxBase)])) },
  { item: '산출세액', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, won(e.r.calculatedTax)])) },
  { item: '세액공제 합계', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, won(e.r.creditsApplied)])) },
  { item: '결정세액 (소득세)', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, won(e.r.determinedTax)])) },
  { item: '이미 낸 소득세 (추정)', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, won(e.r.paidIncomeTax)])) },
  { item: '정산 결과 (지방소득세 포함)', ...Object.fromEntries(examples.map((e, i) => [`e${i}`, signed(e.r.diff)])) },
];

/* ---------- 기준표 ---------- */
const bracketRows = INCOME_TAX.brackets.map((b, i) => {
  const from = i === 0 ? 0 : INCOME_TAX.brackets[i - 1].upTo;
  const range =
    i === 0 ? `${koreanAmount(b.upTo)} 이하` : b.upTo === Infinity ? `${koreanAmount(from)} 초과` : `${koreanAmount(from)} 초과 ~ ${koreanAmount(b.upTo)} 이하`;
  return { range, rate: pct(b.rate), deduction: won(b.deduction) };
});
const cardLimitRows = [
  { salary: '7,000만 원 이하', c0: man(CARD.baseLimitLow), c1: man(CARD.baseLimitLow + CARD.childAddLow), c2: man(CARD.baseLimitLow + CARD.childAddLowMax) },
  { salary: '7,000만 원 초과', c0: man(CARD.baseLimitHigh), c1: man(CARD.baseLimitHigh + CARD.childAddHigh), c2: man(CARD.baseLimitHigh + CARD.childAddHighMax) },
];
const cardRateRows = [
  { item: '신용카드', rate: pct(CARD.rates.credit) },
  { item: '체크카드·현금영수증', rate: pct(CARD.rates.debit) },
  { item: '도서·공연·박물관·미술관·영화·수영장·체력단련장 (총급여 7,000만 원 이하)', rate: pct(CARD.rates.culture) },
  { item: '전통시장·대중교통', rate: pct(CARD.rates.market) },
];
const creditRows = [
  { item: '근로소득세액공제', rule: '산출세액 130만 원 이하 55%, 초과분 30%. 총급여에 따라 한도 74만~20만 원', basis: '소득세법 제59조' },
  { item: '자녀세액공제', rule: `만 9세 이상 자녀 1명 ${man(CHILD_CREDIT.one)}, 2명 ${man(CHILD_CREDIT.two)}, 3명부터 1명당 ${man(CHILD_CREDIT.perExtra)} 추가`, basis: '소득세법 제59조의2' },
  { item: '출산·입양', rule: `첫째 ${man(CHILD_CREDIT.birth.first)}, 둘째 ${man(CHILD_CREDIT.birth.second)}, 셋째 이상 ${man(CHILD_CREDIT.birth.third)}`, basis: '소득세법 제59조의2' },
  { item: '연금계좌', rule: `연금저축 ${man(PENSION_ACCOUNT.savingLimit)}, IRP 포함 ${man(PENSION_ACCOUNT.totalLimit)} 한도, 공제율 ${pct(PENSION_ACCOUNT.rateLow)} (총급여 5,500만 원 초과 ${pct(PENSION_ACCOUNT.rateHigh)})`, basis: '소득세법 제59조의3' },
  { item: '보험료', rule: `보장성 보험료 ${man(SPECIAL_CREDIT.insuranceLimit)}까지 ${pct(SPECIAL_CREDIT.insuranceRate)}`, basis: '소득세법 제59조의4' },
  { item: '의료비', rule: `총급여 3%를 넘는 금액의 ${pct(SPECIAL_CREDIT.medicalRate)}, 그 외 가족분은 ${man(SPECIAL_CREDIT.medicalOtherLimit)} 한도`, basis: '소득세법 제59조의4' },
  { item: '교육비', rule: `${pct(SPECIAL_CREDIT.educationRate)}, 취학 전·초중고 1인 ${man(SPECIAL_CREDIT.educationPerChildLimit)}, 대학 1인 ${man(SPECIAL_CREDIT.educationPerUnivLimit)} 한도 (본인은 한도 없음)`, basis: '소득세법 제59조의4' },
  { item: '기부금', rule: `${man(SPECIAL_CREDIT.donationHighBoundary)}까지 ${pct(SPECIAL_CREDIT.donationRate)}, 초과분 ${pct(SPECIAL_CREDIT.donationHighRate)}`, basis: '소득세법 제59조의4' },
  { item: '월세', rule: `총급여 8,000만 원 이하 무주택 세대주, 연 ${man(RENT_CREDIT.maxRent)}까지 ${pct(RENT_CREDIT.rateLow)} (총급여 5,500만 원 초과 ${pct(RENT_CREDIT.rateHigh)})`, basis: '조세특례제한법 제95조의2' },
  { item: '결혼', rule: `2024~2026년 혼인신고 시 1회 ${man(MARRIAGE_CREDIT)}`, basis: '조세특례제한법 제92조의3' },
  { item: '표준세액공제', rule: `${won(STANDARD_CREDIT)}. 항목별 공제와 비교해 유리한 쪽을 자동으로 골라요`, basis: '소득세법 제59조의4' },
];

const faqs = [
  {
    q: '환급과 추가 납부는 어떻게 갈리나요?',
    a: '연말정산은 1년 동안 월급에서 미리 뗀 소득세와 실제로 내야 할 세금(결정세액)을 비교하는 절차예요. 이미 낸 세금이 더 많으면 차액을 돌려받고(환급), 적으면 모자란 만큼 더 내요(추가 납부). 돈셈은 결정세액에서 이미 낸 세금을 뺀 값이 음수면 환급, 양수면 추가 납부로 보여 드려요.',
  },
  {
    q: '이미 낸 소득세는 어디서 찾나요?',
    a: '회사에서 받는 근로소득 원천징수영수증이나 12월 급여명세서의 "소득세" 연간 합계(또는 1~11월 합계에 12월 예상분)에서 찾을 수 있어요. 홈택스의 연말정산 미리보기에서도 확인할 수 있어요. 값을 비워 두면 연봉으로 간이세액을 추정해서 계산하고, 추정치라는 표시가 나와요. 정확한 결과가 필요하면 실제 금액을 넣어 주세요.',
  },
  {
    q: '표준세액공제는 무엇인가요?',
    a: `보험료·의료비·교육비·기부금·월세 세액공제를 신청하지 않을 때 ${won(STANDARD_CREDIT)}을 세액에서 빼 주는 제도예요. 항목별 공제를 모두 합한 금액이 이보다 크면 항목별로 신청하는 편이 세금이 적어요. 돈셈은 두 방식의 결정세액을 모두 계산해서 낮은 쪽을 자동으로 고르고, 어느 쪽인지 결과 아래에 알려 드려요.`,
  },
  {
    q: '자녀세액공제는 몇 살부터 받을 수 있나요?',
    a: `${YE_BASE_YEAR}년 귀속 연말정산에서는 만 ${CHILD_CREDIT.minAge}세 이상 20세 이하 기본공제 대상 자녀가 자녀세액공제 대상이에요. 나이 기준은 해마다 단계적으로 조정되고 있어서 입력칸 라벨에도 나이를 적어 두었어요. 만 8세 이하 자녀는 자녀세액공제는 없지만 기본공제와 카드 소득공제 한도 가산에는 반영돼요. 올해 태어나거나 입양한 자녀는 별도로 출산·입양 세액공제를 고를 수 있어요.`,
  },
  {
    q: '이 계산기가 다루지 않는 항목은 무엇인가요?',
    a: '부녀자·한부모 추가공제, 소비증가분 카드 추가공제, 고향사랑기부금·정치자금 기부금 특례, 장기주택저당차입금 이자 상환액 공제, 국외 소득, 중도 입·퇴사자, 둘 이상 회사 합산은 범위 밖이에요. 이런 항목이 있다면 홈택스 연말정산 미리보기나 회사 담당자에게 확인해 주세요.',
  },
  {
    q: '회사 결과와 계산 결과가 다른 이유가 뭔가요?',
    a: '회사는 간소화 자료로 실제 지출을 확인해서 정산하고, 돈셈은 입력한 숫자를 기준으로 계산해서 차이가 생겨요. 부양가족 요건(소득 기준), 카드 종류별 구분, 의료비·교육비 해당 여부, 월 중 입사·퇴사, 상여금 시기에 따른 기납부세액 차이도 이유가 돼요. 이 계산기는 참고용이고 실제 정산은 회사와 국세청 기준으로 확정돼요.',
  },
];

const changelog = [{ date: '2026-11-18', text: `최초 공개. ${YE_BASE_YEAR}년 귀속 기준으로 카드 소득공제 한도 상향, 자녀세액공제 나이 기준, 초등 저학년 예체능 학원비 포함을 반영했어요.` }];

const pageUrl = new URL('/year-end-tax/', SITE_URL).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${SITE_NAME} 연말정산 계산기`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    inLanguage: 'ko',
    url: pageUrl,
    description,
    datePublished: tool.published,
    dateModified: tool.updated,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
];

const stepperMax = { seniors: d.dependents, disabled: d.dependents, children: Math.max(0, d.dependents - 1), youngChildren: Math.max(0, d.dependents - 1) };
const cardFields = [
  { id: 'cardCredit', label: '신용카드', hint: '1년 동안 쓴 금액이에요. 홈택스 간소화 자료에서 확인해요.' },
  { id: 'cardDebit', label: '체크카드·현금영수증', hint: '직불카드, 선불카드, 현금영수증을 합쳐요.' },
  { id: 'cardCulture', label: '도서·공연·박물관·영화·체육시설', hint: '총급여 7,000만 원 이하만 공제율이 높아요. 초과하면 일반 사용액으로 계산해요.' },
  { id: 'cardMarket', label: '전통시장', hint: '' },
  { id: 'cardTransit', label: '대중교통', hint: '버스·지하철 같은 대중교통 이용분이에요. 택시는 해당하지 않아요.' },
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} breadcrumbs={[{ name: taxCat.name, href: '/tax/' }, { name: '연말정산 계산기' }]}>
  <PageHeader title="연말정산 계산기" description={`연봉과 사용한 금액을 넣으면 ${YE_BASE_YEAR}년 귀속 환급액을 알려드려요.`} />

  <section class="calc" aria-labelledby="calc-title">
    <h2 id="calc-title" class="sr-only">계산하기</h2>
    <form id="calc-form" novalidate>
      <div class="main-input">
        <MoneyInput id="annualSalary" label="세전 연봉" value={d.annualSalary} hint="비과세 급여를 포함한 1년치 금액이에요.">
          <Chips target="annualSalary" items={[{ label: '+100만', add: 1_000_000 }, { label: '+500만', add: 5_000_000 }, { label: '+1,000만', add: 10_000_000 }]} />
        </MoneyInput>
      </div>

      <div class="result">
        <ResultHero
          label={out.heroLabel}
          labelOut="heroLabel"
          out="diffAbs"
          value={out.diffAbs}
          kind={initial.kind}
          captionOut="heroCaption"
          caption={out.heroCaption}
          subs={[
            { label: '내야 할 세금', value: out.determinedTotal, out: 'determinedTotal' },
            { label: '이미 낸 세금', value: out.paidTotal, out: 'paidTotal' },
          ]}
        >
          <p class="badge caption">
            <span class="ic ic-refund" aria-hidden="true"><Check /></span>
            <span class="ic ic-extra" aria-hidden="true"><Info /></span>
            <span data-out="badge">{out.badge}</span>
          </p>
          <p class="caption muted disclaimer">참고용 계산이에요. 실제 정산은 회사·국세청 기준으로 확정돼요.</p>
          <p class="caption muted" data-result-note hidden>이미 낸 세금은 연봉으로 추정한 값이에요. '이미 낸 세금' 칸에 실제 금액을 넣으면 더 정확해요.</p>
        </ResultHero>
      </div>

      <div class="cond">
        <h3>조건 바꾸기</h3>

        <Details summary="기본 정보 (비과세·가족)" open>
          <MoneyInput id="monthlyNonTaxable" label="월 비과세액" value={d.monthlyNonTaxable} hint="식대처럼 세금이 붙지 않는 돈이에요. 기본값은 식대 한도 20만 원이에요.">
            <Chips target="monthlyNonTaxable" label="비과세액 빠른 입력" items={[{ label: '없음', set: 0 }, { label: '식대 20만', set: 200_000 }]} />
          </MoneyInput>
          <Stepper id="dependents" label="기본공제 인원 (본인 포함)" value={d.dependents} min={1} max={20} hint="혼자라면 1명이에요. 배우자·자녀·부모 등 기본공제를 받는 가족을 더해요." />
          <Stepper id="seniors" label="70세 이상 인원" value={d.seniors} min={0} max={stepperMax.seniors} hint="본인과 가족 중 만 70세 이상이면 1인당 100만 원 추가 공제예요." />
          <Stepper id="disabled" label="장애인 인원" value={d.disabled} min={0} max={stepperMax.disabled} hint="1인당 200만 원 추가 공제예요." />
          <Stepper id="children" label="만 9세 이상 ~ 20세 이하 자녀 수" value={d.children} min={0} max={stepperMax.children} hint="기본공제를 받는 자녀만 세어요. 자녀세액공제 대상이에요." />
          <Stepper id="youngChildren" label="만 8세 이하 자녀 수" value={d.youngChildren} min={0} max={stepperMax.youngChildren} hint="카드 소득공제 한도 가산에만 반영돼요." />
          <Segmented name="birthOrder" legend="올해 태어나거나 입양한 자녀" value={String(d.birthOrder)} options={[{ value: '0', label: '없음' }, { value: '1', label: '첫째' }, { value: '2', label: '둘째' }, { value: '3', label: '셋째 이상' }]} />
