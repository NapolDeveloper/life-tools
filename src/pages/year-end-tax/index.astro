          <MoneyInput id="medicalOther" label="의료비: 그 외 가족" value={d.medicalOther} hint="연 700만 원까지만 공제 대상이에요." />
          <MoneyInput id="eduSelf" label="교육비: 본인" value={d.eduSelf} hint="대학원·직업능력개발 훈련비도 해당해요. 한도가 없어요." />
          <MoneyInput id="eduKids" label="교육비: 취학 전·초중고 자녀 합계" value={d.eduKids} hint="1인당 300만 원까지 공제 대상이에요." />
          <Stepper id="eduKidsCount" label="교육비를 쓴 취학 전·초중고 자녀 수" value={d.eduKidsCount} min={0} max={10} />
          <MoneyInput id="eduUniv" label="교육비: 대학생 자녀 합계" value={d.eduUniv} hint="1인당 900만 원까지 공제 대상이에요." />
          <Stepper id="eduUnivCount" label="교육비를 쓴 대학생 자녀 수" value={d.eduUnivCount} min={0} max={10} />
