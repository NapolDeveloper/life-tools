---
/**
 * 디자인 시스템 쇼케이스 (site-03 §6). preview 빌드에서만 생성하고 noindex, sitemap 제외.
 * 사용자 검수용이라 production 빌드에서는 getStaticPaths가 빈 목록을 돌려줘 페이지가 만들어지지 않는다.
 */
import { readFileSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Field from '../../components/ui/Field.astro';
import MoneyInput from '../../components/ui/MoneyInput.astro';
import Chips from '../../components/ui/Chips.astro';
import Stepper from '../../components/ui/Stepper.astro';
import Segmented from '../../components/ui/Segmented.astro';
import Details from '../../components/ui/Details.astro';
import ResultHero from '../../components/ui/ResultHero.astro';
import ResultTable from '../../components/ui/ResultTable.astro';
import StickyResultBar from '../../components/ui/StickyResultBar.astro';
import CopyButton from '../../components/ui/CopyButton.astro';
import ShareButton from '../../components/ui/ShareButton.astro';
import Toast from '../../components/ui/Toast.astro';
import Steps from '../../components/ui/Steps.astro';
import DataTable from '../../components/ui/DataTable.astro';
import SourceList from '../../components/ui/SourceList.astro';
import Notice from '../../components/ui/Notice.astro';
import FaqList from '../../components/ui/FaqList.astro';
import ChangeLog from '../../components/ui/ChangeLog.astro';
import ToolCard from '../../components/ui/ToolCard.astro';
import RelatedTools from '../../components/ui/RelatedTools.astro';
import CategoryHub from '../../components/ui/CategoryHub.astro';
import AdSlot from '../../components/ui/AdSlot.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Plus from '../../components/icons/Plus.astro';
import { TOOLS } from '../../config';
import { IS_PRODUCTION } from '../../lib/env';

export function getStaticPaths() {
  return IS_PRODUCTION ? [] : [{ params: { slug: undefined } }];
}

// 토큰 값을 tokens.css에서 읽어 견본으로 보여 준다 (값의 단일 출처는 tokens.css).
const css = readFileSync(`${process.cwd()}/src/styles/tokens.css`, 'utf8');
const darkAt = css.indexOf('prefers-color-scheme: dark');
const decls = (block: string) => Object.fromEntries([...block.matchAll(/--([a-z0-9-]+):\s*(#[0-9a-fA-F]{6}|var\(--[a-z0-9-]+\))\s*;/g)].map((m) => [m[1], m[2]]));
const lightRaw = decls(css.slice(0, darkAt));
const darkRaw = { ...lightRaw, ...decls(css.slice(darkAt)) };
const resolve = (raw: Record<string, string>, name: string): string => {
  const v = raw[name];
  const ref = v.match(/^var\(--([a-z0-9-]+)\)$/);
  return ref ? resolve(raw, ref[1]) : v;
};
const scale = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900];
const palette = (p: string) => scale.map((n) => ({ name: `${p}-${n}`, hex: resolve(lightRaw, `${p}-${n}`), decor: p === 'green' && (n === 400 || n === 500) }));
const semantic = [
  ['bg', '페이지 배경'], ['bg-sub', '섹션 구분 띠, 입력칸 면, 보조 카드'], ['surface', '카드'], ['surface-sub', '표 머리, 눌림 상태'],
  ['text', '제목·본문'], ['text-sub', '설명·라벨'], ['text-tertiary', '캡션·힌트 (흰/grey-50 위에서만)'],
  ['line', '구분선(장식)'], ['line-strong', '입력 외곽이 필요할 때(3:1)'],
  ['primary', '주 버튼 배경·링크·핵심 숫자'], ['primary-pressed', '눌림'], ['primary-weak', '보조 버튼 배경·결과 카드 배경'],
  ['on-primary', 'primary 위 글자'], ['on-primary-weak', 'primary-weak 위 글자'], ['danger', '오류'], ['warning', '주의'],
].map(([n, u]) => ({ name: n, usage: u, ref: lightRaw[`color-${n}`], light: resolve(lightRaw, `color-${n}`), dark: resolve(darkRaw, `color-${n}`) }));
const typeScale = [
  { token: 'display', label: '핵심 결과 숫자', sample: '2,924,353원', spec: '34/44px · 700' },
  { token: 'title-1', label: '페이지 제목(H1)', sample: '연봉 실수령액 계산기', spec: '26/36px · 700' },
  { token: 'title-2', label: '섹션 제목(H2)', sample: '계산 방식과 근거', spec: '22/31px · 700' },
  { token: 'title-3', label: '소제목·카드 제목', sample: '소득세 계산 순서', spec: '19/27px · 600' },
  { token: 'body-1', label: '본문·입력값', sample: '연봉을 넣으면 매달 받는 돈을 알려드려요.', spec: '17/26px · 400' },
  { token: 'body-2', label: '보조 설명·표', sample: '식대처럼 세금이 붙지 않는 돈이에요.', spec: '15/23px · 400' },
  { token: 'caption', label: '힌트·각주', sample: '상여금·성과급은 빼고 넣어요.', spec: '13/19px · 400' },
];
const spaces = [['1', '4'], ['2', '8'], ['3', '12'], ['4', '16'], ['5', '20'], ['6', '24'], ['7', '32'], ['8', '40'], ['9', '48'], ['10', '64']];
const radii = [['sm', '8px', '작은 요소'], ['md', '12px', '입력'], ['lg', '16px', '버튼'], ['xl', '20px', '카드'], ['full', '9999px', '칩·스테퍼']];
---
<BaseLayout title="디자인 시스템" description="돈셈 디자인 토큰과 UI 컴포넌트를 한곳에서 확인하는 검수용 페이지예요. 미리보기에서만 열려요." breadcrumbs={[{ name: '디자인 시스템' }]} noindex>
  <PageHeader title="디자인 시스템 v2" description="미리보기 전용 검수 페이지예요. 색은 기기 설정(라이트/다크)을 따라가고, 토큰 표는 두 값을 함께 보여 줘요. 토스 앱의 구성·여백·위계 느낌만 참고했고 토스의 폰트·로고·아이콘·문구는 쓰지 않아요." />
  <nav class="toc" aria-label="이 페이지의 목차">
    <a href="#palette">팔레트</a><a href="#semantic">의미 토큰</a><a href="#type">타이포</a><a href="#space">간격·모서리</a><a href="#buttons">버튼</a><a href="#inputs">입력</a><a href="#results">결과</a><a href="#content">콘텐츠</a><a href="#nav">탐색·광고</a>
  </nav>

  <Section id="palette" title="원색 팔레트">
    <p class="muted small">의미 토큰의 값으로만 써요. green-400·500은 아이콘·장식·그래프 전용이고 텍스트에는 쓰지 않아요.</p>
    {['green', 'grey'].map((p) => (
      <ul class="scale" aria-label={`${p} 팔레트`}>
        {palette(p).map((c) => (
          <li>
            <span class="sw" style={`background:${c.hex}`} aria-hidden="true"></span>
            <code>{c.name}</code><span class="caption tertiary">{c.hex}{c.decor ? ' · 장식 전용' : ''}</span>
          </li>
        ))}
      </ul>
    ))}
  </Section>

  <Section id="semantic" title="의미 토큰">
    <p class="muted small">컴포넌트는 이 토큰만 써요. 왼쪽 칩이 라이트, 오른쪽이 다크 값이에요.</p>
    <ul class="tokens">
      {semantic.map((t) => (
        <li>
          <span class="pair" aria-hidden="true"><span style={`background:${t.light}`}></span><span style={`background:${t.dark}`}></span></span>
          <div><code>--color-{t.name}</code><br /><span class="caption tertiary">{t.usage}</span><br /><span class="caption tertiary">{t.light} / {t.dark}{t.ref.startsWith('var') ? ` · ${t.ref.slice(4, -1).slice(2)}` : ''}</span></div>
        </li>
      ))}
    </ul>
    <h3>현재 테마에서 보기</h3>
    <div class="theme-sample">
      <p>본문 텍스트 <span class="muted">text-sub</span> <span class="tertiary">text-tertiary</span> <a href="#semantic">링크</a></p>
      <p class="weak-box">primary-weak 위 <strong>on-primary-weak 강조</strong></p>
      <p><span class="d">오류 danger</span> · <span class="w">주의 warning</span></p>
    </div>
  </Section>

  <Section id="type" title="타이포그래피">
    <p class="muted small">글꼴은 Pretendard(서브셋, font-display: swap)이고 숫자에는 tabular-nums, 제목 자간은 -0.02em이에요.</p>
    <ul class="types">
      {typeScale.map((t) => (
        <li>
          <span class="caption tertiary">{t.token} · {t.spec} · {t.label}</span>
          <span class={`t-${t.token}`}>{t.sample}</span>
        </li>
      ))}
    </ul>
    <p class="num">tabular-nums: 1,111,111 / 8,888,888 (자릿수가 맞춰져요)</p>
  </Section>

  <Section id="space" title="간격·모서리·레이아웃">
    <ul class="spaces">
      {spaces.map(([n, px]) => (
        <li><code>--space-{n}</code><span class="bar" style={`width:var(--space-${n})`}></span><span class="caption tertiary">{px}px</span></li>
      ))}
    </ul>
    <ul class="radii">
      {radii.map(([n, px, d]) => <li class={`r-${n}`}><code>--radius-{n}</code><span class="caption muted">{px} · {d}</span></li>)}
    </ul>
    <p class="small muted">그림자는 쓰지 않아요. 하단 고정 결과바만 위쪽 1px 선(<code>--color-line</code>)을 써요. 본문·계산기 최대 폭 640px, 모바일 좌우 여백 20px, 터치 영역 44×44px 이상, 버튼 높이 L 56 / M 48 / S 36px, 모션 150~250ms ease-out, 누르면 scale 0.98(reduced-motion이면 생략)이에요.</p>
    <h3>Section 구분 띠 (12px bg-sub, 전체 폭)</h3>
    <p class="small muted">이 페이지의 블록 사이에 보이는 회색 띠가 그거예요.</p>
  </Section>

  <Section id="buttons" title="버튼">
    <p class="muted small">primary는 페이지당 1개, 주요 행동은 전체 폭 L 버튼이에요.</p>
    <h3>종류 × 크기</h3>
    <div class="stack">
      <Button variant="primary" size="l" block>Primary L</Button>
      <Button variant="weak" size="l" block>Weak L</Button>
      <Button variant="grey" size="l" block>Grey L</Button>
    </div>
    <div class="row">
      <Button variant="primary">Primary M</Button><Button variant="weak">Weak M</Button><Button variant="grey">Grey M</Button><Button variant="text">Text M</Button>
    </div>
    <div class="row">
      <Button variant="primary" size="s">Primary S</Button><Button variant="weak" size="s">Weak S</Button><Button variant="grey" size="s">Grey S</Button><Button variant="text" size="s"><Plus />Text S</Button>
    </div>
    <h3>상태</h3>
    <div class="row">
      <span class="force-press"><Button variant="primary">눌림(0.98)</Button></span>
      <Button variant="primary" disabled>비활성</Button>
      <Button href="/salary/" variant="weak">링크 버튼</Button>
    </div>
    <div class="share-demo"><CopyButton /><ShareButton /></div>
  </Section>

  <Section id="inputs" title="입력">
    <h3>MoneyInput (bg-sub 면 · 포커스 2px primary 링)</h3>
    <MoneyInput id="ds-money" label="기본" value={40000000} hint="콤마·단위·한글 읽기가 붙는 금액 입력이에요.">
      <Chips target="ds-money" items={[{ label: '+100만', add: 1000000 }, { label: '+1,000만', add: 10000000 }]} />
    </MoneyInput>
    <div class="force-focus">
      <MoneyInput id="ds-money-focus" label="포커스 (Tab으로 확인)" value={4500000} />
    </div>
    <h3>오류 상태</h3>
    <MoneyInput id="ds-money-err" label="오류" value={0} hint="오류 메시지는 aria-describedby로 연결돼요." />
    <h3>Chips (기본 / 선택)</h3>
    <div class="chips-demo">
      <Chips target="ds-money" label="기본 칩" items={[{ label: '없음', add: 0 }, { label: '+10만', add: 100000 }]} />
      <Chips target="ds-money" label="선택 칩" items={[{ label: '식대 20만', set: 200000 }]} />
    </div>
    <h3>Stepper</h3>
    <Stepper id="ds-step" label="부양가족 수" value={2} min={1} max={5} hint="정수 개수는 −/+로 바꿔요." />
    <Stepper id="ds-step-min" label="최솟값 상태" value={1} min={1} max={5} />
    <h3>Segmented</h3>
    <Segmented name="ds-seg" legend="2~4개 선택지" value="b" options={[{ value: 'a', label: '월' }, { value: 'b', label: '연' }, { value: 'c', label: '시급' }]} />
    <h3>Field (오류)</h3>
    <Field id="ds-err" label="일반 입력의 오류 상태" hint="힌트 한 줄은 이렇게 보여요.">
      <input id="ds-err" type="text" value="-5" aria-invalid="true" aria-describedby="ds-err-hint ds-err-error" class="plain-input" />
    </Field>
    <h3>Details</h3>
    <Details summary="상세 옵션 (펼침)" open><p class="small muted">선택 항목은 접기 안에 둬요. 키보드로 열고 닫을 수 있어요.</p></Details>
    <Details summary="닫힌 상태"><p>내용</p></Details>
  </Section>

  <Section id="results" title="결과">
    <h3>ResultHero</h3>
    <ResultHero label="월 예상 실수령액" value="2,924,353원" caption="세전 월급 3,333,333원 기준" subs={[{ label: '연 실수령액', value: '35,092,236원' }, { label: '월 공제 합계', value: '408,980원' }]}>
      <p class="caption muted">참고용이에요. 실제 급여와 다를 수 있어요.</p>
    </ResultHero>
    <h3>ResultHero 오류</h3>
    <div data-demo-error><ResultHero label="월 예상 실수령액" value="-" caption="" /></div>
    <h3>ResultTable (행 구분선 없음, 합계만 위 1px line)</h3>
    <ResultTable
      caption="월 기준 (2026년 기준)"
      rows={[{ key: 'a', label: '국민연금', amount: '148,830원', ratio: '4.5%' }, { key: 'b', label: '건강보험', amount: '112,640원', ratio: '3.4%' }]}
      totals={[{ key: 't', label: '월 실수령액', amount: '2,924,353원', ratio: '87.7%' }]}
    />
    <h3>StickyResultBar · Toast (모바일 폭에서 보여요)</h3>
    <div class="demo-fixed"><StickyResultBar label="월 실수령액" value="2,924,353원" /></div>
    <div class="demo-fixed"><Toast /></div>
  </Section>

  <Section id="content" title="콘텐츠">
    <h3>Steps</h3>
    <Steps items={[{ title: '연봉을 넣어요', body: '세전 금액을 입력해요.' }, { title: '결과를 확인해요', body: '항목별 공제 내역도 함께 봐요.' }]} />
    <h3>Notice (왼쪽 굵은 선 없음)</h3>
    <Notice>정보 안내는 이렇게 보여요.</Notice>
    <Notice variant="warning" title="참고용 안내">주의가 필요한 안내는 이렇게 보여요.</Notice>
    <h3>DataTable</h3>
    <DataTable caption="연봉별 월 실수령액" columns={[{ key: 'a', label: '연봉' }, { key: 'b', label: '월 실수령액', align: 'right' }]} rows={[{ a: '3,000만 원', b: '2,2xx,xxx원' }, { a: '4,000만 원', b: '2,924,353원' }]} />
    <h3>SourceList</h3>
    <SourceList asOf="2026-11-18" sources={[{ org: '국세청', name: '근로소득 간이세액표', url: 'https://www.nts.go.kr/', note: '소득세' }]} />
    <h3>FaqList</h3>
    <FaqList items={[{ q: '질문은 이렇게 보여요.', a: '답변은 펼치면 나와요.' }, { q: '두 번째 질문이에요.', a: '키보드로도 열 수 있어요.' }]} />
    <h3>ChangeLog</h3>
    <ChangeLog items={[{ date: '2026-11-18', text: '최초 공개.' }]} />
  </Section>

  <Section id="nav" title="탐색·광고">
    <h3>Header (이 페이지 맨 위, 스크롤하면 하단 1px 선)</h3>
    <p class="small muted">워드마크 "돈셈"은 title-3 700 primary예요.</p>
    <h3>Breadcrumb</h3>
    <Breadcrumb items={[{ name: '홈', href: '/' }, { name: '급여', href: '/pay/' }, { name: '연봉 실수령액 계산기' }]} />
    <h3>ToolCard · RelatedTools</h3>
    <ToolCard tool={TOOLS[0]} />
    <RelatedTools category="pay" current="none" />
    <h3>CategoryHub (세금: 도구 없음 + 준비 중 목록)</h3>
    <CategoryHub category="tax"><p>카테고리 소개 문단이 들어가요.</p></CategoryHub>
  </Section>
  <Section id="ad" title="광고 자리">
    <p class="small muted">미리보기: 회색 빈 자리 + 광고 라벨. 운영 빌드에서는 렌더링하지 않아요.</p>
  </Section>
  <AdSlot />
</BaseLayout>
<script is:inline>
  // 데모용 상태 표시 (실제 동작은 /salary/ 스크립트가 담당)
  var err = document.getElementById('ds-err-error');
  if (err) { err.hidden = false; err.textContent = '연봉은 0보다 커야 해요.'; }
  var me = document.getElementById('ds-money-err');
  var mee = document.getElementById('ds-money-err-error');
  if (me && mee) { me.setAttribute('aria-invalid', 'true'); mee.hidden = false; mee.textContent = '연봉은 0보다 커야 해요.'; }
  var box = document.querySelector('[data-demo-error]');
  if (box) {
    box.querySelector('[data-hero]').dataset.state = 'error';
    var he = box.querySelector('[data-result-error]');
    he.hidden = false; he.textContent = '연봉을 입력해 주세요.';
  }
  var pressed = document.querySelector('[data-chip-set]'); if (pressed) pressed.setAttribute('aria-pressed', 'true');
  var bar = document.querySelector('[data-sticky-bar]'); if (bar) bar.classList.add('show');
  var toast = document.querySelector('[data-toast]'); if (toast) { toast.textContent = '결과를 복사했어요'; toast.classList.add('show'); }
</script>
<style>
  .toc { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); padding-bottom: var(--space-6); font-size: var(--fs-body-2); }
  .toc a { display: inline-flex; align-items: center; min-height: var(--touch-min); }
  code { font-size: var(--fs-caption); background: var(--color-bg-sub); padding: 0 var(--space-1); border-radius: var(--radius-sm); }
  .scale { list-style: none; margin: 0 0 var(--space-5); padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2) var(--space-4); }
  .scale li { display: grid; grid-template-columns: var(--space-9) 1fr; grid-template-rows: auto auto; column-gap: var(--space-3); margin: 0; align-items: center; }
  .scale .sw { grid-row: 1 / 3; width: var(--space-9); height: var(--space-9); border-radius: var(--radius-md); }
  .scale code { justify-self: start; }
  .tokens { list-style: none; margin: 0 0 var(--space-6); padding: 0; display: grid; gap: var(--space-2); }
  .tokens li { display: flex; align-items: center; gap: var(--space-3); margin: 0; background: var(--color-bg-sub); border-radius: var(--radius-lg); padding: var(--space-3); }
  .pair { display: flex; flex: none; border-radius: var(--radius-md); overflow: hidden; outline: 1px solid var(--color-line); }
  .pair span { width: var(--space-7); height: var(--space-9); display: block; }
