---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ui/AdSlot.astro';
import { SITE_NAME, SITE_URL } from '../../config';
import { calculateSalary } from '../../lib/salary';
import { PAYROLL_BASE_YEAR, PENSION, HEALTH, LONG_TERM_CARE, EMPLOYMENT } from '../../data/payroll';

const won = (n: number) => n.toLocaleString('ko-KR');
const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;

const defaults = { annualSalary: 40_000_000, monthlyNonTaxable: 200_000, dependents: 1, children: 0 };
const initial = calculateSalary(defaults);

const rows = [
  { key: 'pension', label: '국민연금' },
  { key: 'health', label: '건강보험' },
  { key: 'longTermCare', label: '장기요양보험' },
  { key: 'employment', label: '고용보험' },
  { key: 'incomeTax', label: '소득세' },
  { key: 'localTax', label: '지방소득세' },
] as const;

const examples = [30_000_000, 40_000_000, 50_000_000].map((annualSalary) => ({
  annualSalary,
  r: calculateSalary({ ...defaults, annualSalary }),
}));

const title = '연봉 실수령액 계산기';
const description = `연봉과 비과세액, 부양가족 수를 입력하면 국민연금·건강보험·장기요양·고용보험·소득세를 뺀 월 예상 실수령액을 계산합니다. ${PAYROLL_BASE_YEAR}년 요율 기준 참고용 계산기.`;

const faqs = [
  {
    q: '계산 결과가 실제 급여명세서와 다른 이유는 뭔가요?',
    a: '소득세는 국세청 간이세액표를 그대로 쓰지 않고 소득세법의 공제·세율 구조로 근사해서 계산하기 때문에 몇 천 원에서 몇 만 원 차이가 날 수 있어요. 또 회사마다 상여금, 각종 수당, 보험료 정산 시점이 달라 명세서와 다를 수 있습니다.',
  },
  {
    q: '비과세액에는 무엇을 넣어야 하나요?',
    a: '월급에 포함된 식대(월 20만원까지), 차량유지비 등 세금이 붙지 않는 항목의 합계를 넣으면 됩니다. 비과세액은 4대보험과 소득세를 계산하는 기준 금액에서 빠지므로 많을수록 공제액이 줄어요. 정확한 금액은 근로계약서나 급여명세서에서 확인하세요.',
  },
  {
    q: '부양가족 수에 본인도 포함하나요?',
    a: '네, 본인을 포함한 숫자를 넣어 주세요. 혼자라면 1, 배우자와 자녀 한 명을 부양한다면 3입니다. 자녀 수는 부양가족에 포함된 20세 이하 자녀만 따로 적습니다.',
  },
  {
    q: '연봉에 퇴직금이 포함되어 있나요?',
    a: '이 계산기는 입력한 연봉을 12개월로 균등하게 나눠 받는다고 가정합니다. 퇴직금이 연봉에 포함된 포괄임금 계약이라면 퇴직금 몫을 뺀 금액을 입력해야 실수령액에 가깝게 나와요. 성과급을 따로 받는 경우도 그 금액은 빼고 입력하세요.',
  },
  {
    q: '4대보험 요율은 매년 바뀌나요?',
    a: `건강보험과 장기요양보험 요율은 보통 매년, 국민연금 기준소득월액 상·하한은 매년 7월에 조정됩니다. 이 페이지는 ${PAYROLL_BASE_YEAR}년 기준 값을 사용하고 있으며, 새 요율이 확인되면 갱신합니다.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${SITE_NAME} ${title}`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    inLanguage: 'ko',
    url: new URL('/salary/', SITE_URL).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} breadcrumbs={[{ name: '급여', href: '/pay/' }, { name: title }]}>
  <h1>{title}</h1>
  <p class="lead">세전 연봉에서 4대보험과 소득세를 빼고 나면 매달 얼마가 통장에 들어오는지 계산해 보세요.</p>

  <section class="card" aria-labelledby="calc-title">
    <h2 id="calc-title" style="margin-top:0">계산하기</h2>
    <form id="salary-form" novalidate>
      <div class="form-grid">
        <div class="field">
          <label for="annual">세전 연봉 (원)</label>
          <input id="annual" name="annual" type="number" inputmode="numeric" min="0" step="1000000" value={defaults.annualSalary} />
          <span class="hint" id="annual-hint">{won(defaults.annualSalary)}원</span>
        </div>
        <div class="field">
          <label for="nontax">월 비과세액 (원)</label>
          <input id="nontax" name="nontax" type="number" inputmode="numeric" min="0" step="10000" value={defaults.monthlyNonTaxable} />
          <span class="hint">기본값 20만원은 식대 비과세 한도예요.</span>
        </div>
        <div class="field">
          <label for="deps">부양가족 수 (본인 포함)</label>
          <input id="deps" name="deps" type="number" inputmode="numeric" min="1" max="20" step="1" value={defaults.dependents} />
        </div>
        <div class="field">
          <label for="kids">20세 이하 자녀 수</label>
          <input id="kids" name="kids" type="number" inputmode="numeric" min="0" max="19" step="1" value={defaults.children} />
          <span class="hint">부양가족 수에 포함된 인원만 입력하세요.</span>
        </div>
      </div>
      <button class="btn" type="submit">계산하기</button>
    </form>

    <div class="result-main" aria-live="polite">
      <div class="label">월 예상 실수령액</div>
      <div class="value" id="out-net">{won(initial.monthlyNet)}원</div>
      <div class="label">세전 월급 <span id="out-gross">{won(initial.monthlyGross)}</span>원 기준</div>
    </div>

    <div class="table-scroll" style="margin-top:16px">
      <table>
        <caption class="lead" style="text-align:left;caption-side:top">항목별 공제액</caption>
        <thead><tr><th scope="col">항목</th><th scope="col">월</th><th scope="col">연간</th></tr></thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row" style="font-weight:400">{row.label}</th>
              <td data-month={row.key}>{won(initial[row.key])}원</td>
              <td data-year={row.key}>{won(initial[row.key] * 12)}원</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="total"><th scope="row">공제 합계</th><td data-month="monthlyDeductionTotal">{won(initial.monthlyDeductionTotal)}원</td><td data-year="annualDeductionTotal">{won(initial.annualDeductionTotal)}원</td></tr>
          <tr class="total"><th scope="row">실수령액</th><td data-month="monthlyNet">{won(initial.monthlyNet)}원</td><td data-year="annualNet">{won(initial.annualNet)}원</td></tr>
        </tfoot>
      </table>
    </div>
    <p class="notice" style="margin-top:16px">
      참고용 계산입니다. 소득세는 국세청 간이세액표를 근사한 값이라 실제 급여명세서와 다를 수 있어요.
    </p>
  </section>

  <AdSlot />

  <h2>사용법</h2>
  <ol>
    <li>세전 연봉을 원 단위로 입력합니다. 예: 4천만원이면 40000000</li>
    <li>월급에 포함된 비과세액을 입력합니다. 식대를 받는다면 기본값 200000을 그대로 두면 돼요.</li>
    <li>본인을 포함한 부양가족 수와, 그중 20세 이하 자녀 수를 입력합니다.</li>
    <li>숫자를 바꾸면 결과가 바로 갱신됩니다. 항목별 공제액과 연간 합계도 함께 확인하세요.</li>
  </ol>

  <h2>계산 방식</h2>
  <p>
    먼저 연봉을 12로 나눠 세전 월급을 구하고, 여기서 비과세액을 뺀 금액(과세 대상 월급)을 보험료와 세금의 기준으로 삼습니다.
    각 보험료는 10원 미만을 버리고 계산해요.
  </p>
  <div class="table-scroll">
    <table>
      <thead><tr><th scope="col">항목</th><th scope="col">근로자 부담 계산</th></tr></thead>
      <tbody>
        <tr><th scope="row" style="font-weight:400">국민연금</th><td>과세 월급 x {pct(PENSION.employeeRate)} (기준소득월액 {won(PENSION.baseMin)}원~{won(PENSION.baseMax)}원)</td></tr>
        <tr><th scope="row" style="font-weight:400">건강보험</th><td>과세 월급 x {pct(HEALTH.employeeRate)}</td></tr>
        <tr><th scope="row" style="font-weight:400">장기요양보험</th><td>건강보험료 x {pct(LONG_TERM_CARE.rateOnHealthPremium)}</td></tr>
        <tr><th scope="row" style="font-weight:400">고용보험</th><td>과세 월급 x {pct(EMPLOYMENT.employeeRate)}</td></tr>
        <tr><th scope="row" style="font-weight:400">소득세</th><td>아래 설명 참고 (근사)</td></tr>
        <tr><th scope="row" style="font-weight:400">지방소득세</th><td>소득세 x 10%</td></tr>
      </tbody>
    </table>
  </div>
  <h3>소득세 근사 방식</h3>
  <p>
    국세청 근로소득 간이세액표는 월급 구간마다 정해진 값을 보여 주는 표예요. 이 계산기는 표를 그대로 옮기는 대신, 표가 바탕으로 삼는
    소득세법의 구조를 따라 연 단위로 계산한 뒤 12로 나눕니다. 순서는 이래요.
  </p>
  <ol>
    <li>총급여(비과세 제외 연봉)에서 근로소득공제를 뺍니다.</li>
    <li>부양가족 1인당 150만원 기본공제와 낸 4대보험료를 더 뺍니다. 남은 금액이 과세표준이에요.</li>
    <li>과세표준에 누진 세율(6%~45%)을 적용해 산출세액을 구합니다.</li>
    <li>근로소득세액공제, 자녀세액공제, 표준세액공제를 뺀 값을 12개월로 나눕니다.</li>
  </ol>
  <p>
    그래서 실제 간이세액표 값이나 연말정산 결과와 차이가 있을 수 있습니다. 월 중 간이세액 조견표의 80%·120% 선택, 중도 입사, 상여금, 의료비·교육비 같은 개인별 공제는 반영하지 않았어요.
    기준 연도는 {PAYROLL_BASE_YEAR}년이며, 자세한 요율은 국민연금공단, 국민건강보험공단, 국세청 안내를 따랐습니다.
  </p>

  <h2>예시: 연봉별 월 실수령액</h2>
  <p>비과세 월 20만원, 부양가족 본인 1명, 자녀 없음 기준입니다.</p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th scope="col">연봉</th><th scope="col">세전 월급</th><th scope="col">월 공제 합계</th><th scope="col">월 실수령액</th></tr>
      </thead>
      <tbody>
        {examples.map(({ annualSalary, r }) => (
          <tr>
            <th scope="row" style="font-weight:400">{won(annualSalary / 10000)}만원</th>
            <td>{won(r.monthlyGross)}원</td>
            <td>{won(r.monthlyDeductionTotal)}원</td>
            <td><strong>{won(r.monthlyNet)}원</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>자주 묻는 질문</h2>
  <div>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <h2>이용 안내</h2>
  <p class="notice">
    이 계산기의 결과는 참고용이며 실제 급여, 세액, 보험료와 다를 수 있습니다. 급여 협상이나 신고처럼 중요한 결정에는 회사 급여 담당자나 국세청 등 공식 기관의 확인을 거쳐 주세요.
  </p>
</BaseLayout>

<script>
  import { calculateSalary } from '../../lib/salary';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const won = (n: number) => `${n.toLocaleString('ko-KR')}원`;
  const val = (id: string) => Number($<HTMLInputElement>(id).value);

  function render() {
    const r = calculateSalary({
      annualSalary: val('annual'),
      monthlyNonTaxable: val('nontax'),
      dependents: val('deps'),
      children: val('kids'),
    });
    $('out-net').textContent = won(r.monthlyNet);
    $('out-gross').textContent = r.monthlyGross.toLocaleString('ko-KR');
    $('annual-hint').textContent = won(Math.max(0, Math.floor(val('annual') || 0)));
    document.querySelectorAll<HTMLElement>('[data-month]').forEach((el) => {
      el.textContent = won(r[el.dataset.month as keyof typeof r]);
    });
    document.querySelectorAll<HTMLElement>('[data-year]').forEach((el) => {
      const k = el.dataset.year as keyof typeof r;
      el.textContent = won(k === 'annualDeductionTotal' || k === 'annualNet' ? r[k] : r[k] * 12);
    });
  }

  const form = document.getElementById('salary-form') as HTMLFormElement;
  form.addEventListener('input', render);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    render();
  });
</script>
