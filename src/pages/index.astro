---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import Section from '../components/ui/Section.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_URL, TOOLS, CATEGORIES, toolsOf } from '../config';

const title = `${SITE_NAME} | 급여·세금·노동 계산기 모음`;
const description =
  '연봉 실수령액부터 세금, 퇴직금까지 헷갈리는 돈 계산을 쉽게 풀어 드려요. 회원가입 없이 바로 쓰고, 입력한 값은 내 브라우저 안에서만 계산해요.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    alternateName: 'donsem',
    url: new URL('/', SITE_URL).href,
    inLanguage: 'ko',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: new URL('/', SITE_URL).href,
  },
];
---
<BaseLayout title={title} rawTitle description={description} jsonLd={jsonLd}>
  <header class="hero">
    <h1>{SITE_TAGLINE}</h1>
    <p class="lead">
      월급이 실제로 얼마나 들어오는지, 세금은 얼마나 나가는지 숫자 하나만 넣고 바로 확인해 보세요. 회원가입은 필요 없고, 입력한 값은 내 브라우저 안에서만 계산돼요.
    </p>
  </header>

  <Section id="tools" title="계산기">
    <div class="grid">{TOOLS.map((t) => <ToolCard tool={t} />)}</div>
    <p class="small muted more"><a href="/tools/">전체 계산기 보기</a> · 새 계산기는 준비되는 대로 계속 추가해요.</p>
  </Section>

  <Section id="categories" title="분야별로 찾기">
    <div class="grid">
      {CATEGORIES.map((c) => (
        <a class="cat-card" href={`/${c.slug}/`}>
          <strong>{c.name}</strong>
          <span class="small muted">
            {toolsOf(c.slug).length > 0 ? `계산기 ${toolsOf(c.slug).length}개 공개 · ` : ''}준비 중 {c.planned.length}개
          </span>
        </a>
      ))}
    </div>
  </Section>

  <Section id="how" title="돈셈은 이렇게 만들어요">
    <p>
      모든 계산기에는 사용법, 계산 방식, 예시, 자주 묻는 질문을 함께 적어 두었어요. 어떤 기준으로 숫자가 나왔는지 직접 따라가 볼 수 있어야 결과를 믿고 쓸 수 있다고 생각하기 때문이에요.
    </p>
    <p>
      요율과 기준값은 국민연금공단, 국세청 같은 공공기관 자료를 기준으로 하고, 기준 연도와 확인일을 페이지에 공개해요. 공식 계산기와 같은 값을 넣어 비교하는 검증도 거치고요. 자세한 원칙은 <a href="/about/">돈셈 소개</a>에서 볼 수 있어요.
    </p>
    <p>
      계산 결과는 참고용이에요. 급여 협상이나 세금 신고처럼 중요한 결정 앞에서는 공식 기관의 안내를 함께 확인해 주세요.
    </p>
  </Section>
</BaseLayout>
<style>
  .hero { padding-top: var(--space-8); padding-bottom: var(--space-8); }
  h1 { font-size: var(--fs-display); line-height: var(--lh-display); }
  .lead { margin: var(--space-4) 0 0; color: var(--color-text-sub); font-size: var(--fs-body-1); line-height: var(--lh-body-1); }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  .more { margin: var(--space-4) 0 0; }
  .cat-card {
    display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-5);
    background: var(--color-bg-sub); border-radius: var(--radius-xl);
    color: var(--color-text); text-decoration: none; min-height: var(--touch-min);
    transition: background-color var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease);
  }
  .cat-card:focus-visible { border-radius: var(--radius-xl); }
  @media (hover: hover) { .cat-card:hover { background: var(--color-primary-weak); color: var(--color-text); } }
  @media (prefers-reduced-motion: no-preference) { .cat-card:active { transform: scale(var(--press-scale)); } }
  .cat-card strong { font-size: var(--fs-title-3); line-height: var(--lh-title-3); letter-spacing: var(--tracking-title); }
</style>
