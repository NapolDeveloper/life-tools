---
/** H2 블록. 페이지 구조(site-01 §2)의 한 칸. */
interface Props { title: string; id?: string; wide?: boolean }
const { title, id, wide = false } = Astro.props;
---
<section class:list={['section', { prose: !wide }]} aria-labelledby={id ? `${id}-title` : undefined} id={id}>
  <h2 id={id ? `${id}-title` : undefined}>{title}</h2>
  <slot />
</section>
<style>
  .section { margin-top: var(--space-7); }
  h2 { margin-bottom: var(--space-3); }
  .section :global(h3) { margin: var(--space-5) 0 var(--space-2); }
</style>
