---
import ArrowRight from '../icons/ArrowRight.astro';
import { getCategory, type Tool } from '../../config';
interface Props { tool: Tool }
const { tool } = Astro.props;
---
<a class="tool-card" href={`/${tool.slug}/`}>
  <span class="cat caption">{getCategory(tool.category).name}</span>
  <strong>{tool.name}</strong>
  <span class="desc small">{tool.description}</span>
  <span class="go small">계산하러 가기 <ArrowRight /></span>
</a>
<style>
  .tool-card {
    display: flex; flex-direction: column; gap: var(--space-1); height: 100%;
    padding: var(--space-5); background: var(--color-bg-sub);
    border-radius: var(--radius-xl); color: var(--color-text); text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease);
  }
  .tool-card:focus-visible { border-radius: var(--radius-xl); }
  @media (hover: hover) { .tool-card:hover { background: var(--color-primary-weak); color: var(--color-text); } }
  @media (prefers-reduced-motion: no-preference) { .tool-card:active { transform: scale(var(--press-scale)); } }
  .cat { color: var(--color-primary); font-weight: 600; }
  strong { font-size: var(--fs-title-3); line-height: var(--lh-title-3); letter-spacing: var(--tracking-title); }
  .desc { color: var(--color-text-sub); flex: 1; }
  .go { color: var(--color-primary); font-weight: 600; margin-top: var(--space-2); }
</style>
