---
import ArrowRight from '../icons/ArrowRight.astro';
import { getCategory, type Tool } from '../../config';
interface Props { tool: Tool }
const { tool } = Astro.props;
---
<a class="tool-card" href={`/${tool.slug}/`}>
  <span class="cat small">{getCategory(tool.category).name}</span>
  <strong>{tool.name}</strong>
  <span class="desc small">{tool.description}</span>
  <span class="go small">계산하러 가기 <ArrowRight /></span>
</a>
<style>
  .tool-card {
    display: flex; flex-direction: column; gap: var(--space-1); height: 100%;
    padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); color: var(--color-text); text-decoration: none;
    transition: border-color var(--duration-fast), background-color var(--duration-fast);
  }
  .tool-card:hover { border-color: var(--color-primary); background: var(--color-primary-soft); color: var(--color-text); }
  .cat { color: var(--color-primary); font-weight: 600; }
  strong { font-size: var(--text-h3); line-height: var(--text-h3-lh); }
  .desc { color: var(--color-text-muted); flex: 1; }
  .go { color: var(--color-primary); font-weight: 600; margin-top: var(--space-2); }
</style>
