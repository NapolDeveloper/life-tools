---
/** 짧은 알림(2초). 스크립트가 data-toast의 텍스트를 바꾸고 .show를 붙였다 뗀다. */
---
<div class="toast" data-toast role="status" aria-live="polite"></div>
<style>
  .toast {
    position: fixed; left: 50%; bottom: calc(var(--btn-l) + var(--space-9)); z-index: 30;
    width: auto; margin: 0; padding: var(--space-3) var(--space-5);
    transform: translate(-50%, var(--space-3)); opacity: 0; pointer-events: none;
    background: var(--color-text); color: var(--color-bg); border-radius: var(--radius-full);
    font-size: var(--fs-body-2); font-weight: 600; max-width: calc(100vw - var(--space-9)); text-align: center;
    transition: opacity var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease);
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .toast:empty { display: none; }
  @media (min-width: 768px) { .toast { bottom: var(--space-7); } }
</style>
