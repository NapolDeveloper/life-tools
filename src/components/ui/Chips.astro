---
/** 빠른 입력 칩. add는 현재 값에 더하고, set은 그 값으로 바꾼다. 동작은 입력 페이지 스크립트가 data 속성으로 처리한다. */
export interface ChipItem { label: string; add?: number; set?: number }
interface Props { target: string; items: ChipItem[]; label?: string }
const { target, items, label = '빠른 입력' } = Astro.props;
---
<div class="chips" role="group" aria-label={label}>
  {items.map((c) => (
    <button
      type="button"
      class="chip"
      data-chip-target={target}
      data-chip-add={c.add}
      data-chip-set={c.set}
    >{c.label}</button>
  ))}
</div>
<style>
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    min-height: var(--touch-min); padding: 0 var(--space-4);
    background: var(--color-surface); color: var(--color-text);
    border: 1px solid var(--color-border-strong); border-radius: var(--radius-full);
    font-weight: 600; font-size: var(--text-small); cursor: pointer;
    transition: background-color var(--duration-fast), border-color var(--duration-fast);
  }
  .chip:hover { background: var(--color-primary-soft); border-color: var(--color-primary); color: var(--color-primary); }
</style>
