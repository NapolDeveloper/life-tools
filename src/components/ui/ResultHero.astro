---
/**
 * 핵심 결과 카드: 큰 숫자 1개 + 보조 숫자 1~2개. 값이 바뀌면 aria-live="polite"로 알린다.
 * data-out 속성은 계산기 스크립트가 값을 갱신하는 자리다.
 */
export interface HeroSub { label: string; value: string; out?: string }
interface Props { label: string; labelOut?: string; value: string; out?: string; caption?: string; captionOut?: string; subs?: HeroSub[]; kind?: string }
const { label, labelOut, value, out = 'hero', caption, captionOut, subs = [], kind } = Astro.props;
---
<section class="hero" aria-label="계산 결과" data-hero data-kind={kind}>
  <p class="label" data-out={labelOut}>{label}</p>
  <div class="live" aria-live="polite" aria-atomic="true">
    <p class="value num" data-out={out}>{value}</p>
    <p class="error" data-result-error hidden></p>
  </div>
  {caption && <p class="caption num" data-out={captionOut}>{caption}</p>}
  {subs.length > 0 && (
    <dl class="subs">
      {subs.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd class="num" data-out={s.out}>{s.value}</dd>
        </div>
      ))}
    </dl>
  )}
  <slot />
</section>
<style>
  .hero { background: var(--color-primary-weak); border-radius: var(--radius-xl); padding: var(--space-5); }
  .label { margin: 0 0 var(--space-1); font-size: var(--fs-body-2); line-height: var(--lh-body-2); color: var(--color-text-sub); }
  .value {
    margin: 0; font-size: var(--fs-display); font-weight: var(--fw-display); line-height: var(--lh-display);
    letter-spacing: var(--tracking-title); color: var(--color-primary); word-break: keep-all; overflow-wrap: anywhere;
    border-radius: var(--radius-sm);
  }
  .value.flash { animation: flash var(--duration-base) var(--ease); }
  /* 추가 납부처럼 숫자를 강조색으로 두지 않을 때는 본문색 (문구·아이콘으로 구분하므로 색에만 의존하지 않는다) */
  .hero[data-kind='extra'] .value { color: var(--color-text); }
  .error { margin: 0; color: var(--color-danger); font-weight: 700; }
  .caption { margin: var(--space-1) 0 0; font-size: var(--fs-body-2); line-height: var(--lh-body-2); color: var(--color-text-sub); }
  .subs { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin: var(--space-4) 0 0; }
  dt { font-size: var(--fs-caption); line-height: var(--lh-caption); color: var(--color-text-sub); }
  dd { margin: 0; font-weight: 700; font-size: var(--fs-title-3); line-height: var(--lh-title-3); color: var(--color-text); border-radius: var(--radius-sm); }
  dd.flash { animation: flash var(--duration-base) var(--ease); }
  @keyframes flash { from { background: color-mix(in srgb, var(--color-primary) 22%, transparent); } to { background: transparent; } }
  .hero[data-state='error'] .value, .hero[data-state='error'] .caption, .hero[data-state='error'] .subs { display: none; }
  @media (prefers-reduced-motion: reduce) { .value.flash, dd.flash { animation: none; } }
</style>
