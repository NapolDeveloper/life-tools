---
import Minus from '../icons/Minus.astro';
import Plus from '../icons/Plus.astro';
/** 정수 개수 입력 (−/+). bg-sub 면 하나에 −/값/+. 값 칸은 읽기 전용이며 ↑↓ 키로도 바꿀 수 있다. */
interface Props { id: string; label: string; value: number; min?: number; max?: number; hint?: string }
const { id, label, value, min = 0, max = 20, hint } = Astro.props;
---
<div class="field stepper" data-stepper data-min={min} data-max={max}>
  <label for={id}>{label}</label>
  <div class="ctl" role="group" aria-label={label}>
    <button type="button" class="step" data-step="-1" aria-label={`${label} 줄이기`} disabled={value <= min}><Minus /></button>
    <input id={id} name={id} type="text" inputmode="numeric" readonly value={value} aria-describedby={`${hint ? `${id}-hint ` : ''}${id}-error`} />
    <button type="button" class="step" data-step="1" aria-label={`${label} 늘리기`} disabled={value >= max}><Plus /></button>
  </div>
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  <p class="error" id={`${id}-error`} hidden></p>
</div>
<style>
  .field { margin-bottom: var(--space-6); }
  label { display: block; font-size: var(--fs-body-2); line-height: var(--lh-body-2); font-weight: 600; color: var(--color-text-sub); margin-bottom: var(--space-2); }
  .ctl { display: inline-flex; align-items: center; padding: var(--space-1); background: var(--color-bg-sub); border-radius: var(--radius-full); }
  .step {
    width: var(--btn-m); height: var(--btn-m); display: inline-flex; align-items: center; justify-content: center;
    background: transparent; border: 0; border-radius: var(--radius-full); color: var(--color-primary); cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease);
  }
  .step:focus-visible { border-radius: var(--radius-full); }
  .step:disabled { color: var(--color-text-tertiary); cursor: not-allowed; opacity: 0.5; }
  @media (hover: hover) { .step:hover:not(:disabled) { background: var(--color-primary-weak); } }
  @media (prefers-reduced-motion: no-preference) { .step:active:not(:disabled) { transform: scale(var(--press-scale)); } }
  input {
    width: var(--space-10); height: var(--btn-m); text-align: center; border: 0; background: transparent; color: var(--color-text);
    font-size: var(--fs-body-1); font-weight: 700; font-variant-numeric: tabular-nums;
  }
  input:focus-visible { outline-offset: -2px; border-radius: var(--radius-full); }
  .hint { margin: var(--space-2) 0 0; font-size: var(--fs-caption); line-height: var(--lh-caption); color: var(--color-text-tertiary); }
  .error { margin: var(--space-2) 0 0; font-size: var(--fs-body-2); color: var(--color-danger); font-weight: 600; }
</style>
