---
import ToolCard from './ToolCard.astro';
import Section from './Section.astro';
import { toolsOf, getCategory, type CategorySlug } from '../../config';
/** 카테고리 허브: 소개(slot) + 도구 카드 + 준비 중인 계산기(텍스트만, 링크 없음). */
interface Props { category: CategorySlug }
const { category } = Astro.props;
const cat = getCategory(category);
const tools = toolsOf(category);
---
<div class="intro"><slot /></div>
<Section id="hub-tools" title={`${cat.name} 계산기`}>
  {tools.length > 0 ? (
    <div class="grid">{tools.map((t) => <ToolCard tool={t} />)}</div>
  ) : (
    <p class="muted">아직 공개한 계산기가 없어요. 아래 계산기를 준비하고 있어요.</p>
  )}
</Section>
{cat.planned.length > 0 && (
  <Section id="hub-planned" title="준비 중인 계산기">
    <p class="small muted">공식 기준을 확인하고 검증을 마친 순서대로 공개할게요.</p>
    <ul>{cat.planned.map((p) => <li>{p}</li>)}</ul>
  </Section>
)}
<style>
  .intro { padding-bottom: var(--space-8); }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
</style>
