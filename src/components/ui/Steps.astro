---
/** 번호가 붙은 사용법 단계 (3~5단계). bg-sub 면, 번호는 primary 원. */
interface Props { items: { title?: string; body: string }[] }
const { items } = Astro.props;
---
<ol class="steps">
  {items.map((s) => (
    <li>
      {s.title && <strong>{s.title}</strong>}
      <span>{s.body}</span>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; counter-reset: step; margin: 0 0 var(--space-4); padding: 0; }
  li {
    counter-increment: step; position: relative; margin: 0 0 var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-9) + var(--space-3));
    background: var(--color-bg-sub); border-radius: var(--radius-lg);
    font-size: var(--fs-body-2); line-height: var(--lh-body-2); color: var(--color-text-sub);
  }
  li::before {
    content: counter(step); position: absolute; left: var(--space-4); top: var(--space-4);
    width: var(--space-6); height: var(--space-6); border-radius: var(--radius-full);
    background: var(--color-primary); color: var(--color-on-primary); font-weight: 700; font-size: var(--fs-caption);
    display: flex; align-items: center; justify-content: center;
  }
  strong { display: block; color: var(--color-text); font-size: var(--fs-body-1); line-height: var(--lh-body-1); margin-bottom: var(--space-1); }
</style>
