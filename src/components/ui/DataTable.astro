---
/** 일반 데이터 표. caption·th scope 필수. 행 구분선 없이 surface-sub 면 위에 놓고, 모바일에서는 래퍼 안에서만 가로 스크롤. */
export interface Column { key: string; label: string; align?: 'left' | 'right' }
interface Props { caption: string; columns: Column[]; rows: Record<string, string>[]; rowHeader?: boolean }
const { caption, columns, rows, rowHeader = true } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={`${caption} (가로로 스크롤할 수 있어요)`}>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>{columns.map((c) => <th scope="col" class:list={{ r: c.align === 'right' }}>{c.label}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {columns.map((c, i) =>
            i === 0 && rowHeader ? (
              <th scope="row">{row[c.key]}</th>
            ) : (
              <td class:list={['num', { r: c.align === 'right' }]}>{row[c.key]}</td>
            ),
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .table-scroll { overflow-x: auto; background: var(--color-surface-sub); border-radius: var(--radius-lg); padding: var(--space-2) var(--space-4); margin-bottom: var(--space-4); }
  table { width: 100%; border-collapse: collapse; font-size: var(--fs-body-2); line-height: var(--lh-body-2); min-width: 20rem; }
  caption { text-align: left; padding: var(--space-3) 0 var(--space-2); color: var(--color-text-sub); caption-side: top; }
  th, td { padding: var(--space-3) var(--space-2) var(--space-3) 0; text-align: left; vertical-align: top; border: 0; }
  thead th { font-size: var(--fs-caption); line-height: var(--lh-caption); font-weight: 400; color: var(--color-text-tertiary); padding-top: var(--space-1); padding-bottom: var(--space-1); }
  tbody th { font-weight: 600; }
  td:last-child, th:last-child { padding-right: 0; }
  .r { text-align: right; }
</style>
