---
/** 내역 표: 항목 / 금액 / 비율. 합계 행은 tfoot에서 강조한다. data-key로 스크립트가 값을 갱신한다. */
export interface ResultRow { key: string; label: string; amount: string; ratio: string }
interface Props { caption: string; captionOut?: string; rows: ResultRow[]; totals?: ResultRow[] }
const { caption, captionOut, rows, totals = [] } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={`${caption} (가로로 스크롤할 수 있어요)`}>
  <table>
    <caption data-out={captionOut}>{caption}</caption>
    <thead>
      <tr><th scope="col">항목</th><th scope="col" class="r">금액</th><th scope="col" class="r">비율</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-row={r.key}>
          <th scope="row">{r.label}</th>
          <td class="r num" data-amount>{r.amount}</td>
          <td class="r num muted" data-ratio>{r.ratio}</td>
        </tr>
      ))}
    </tbody>
    {totals.length > 0 && (
      <tfoot>
        {totals.map((r) => (
          <tr data-row={r.key}>
            <th scope="row">{r.label}</th>
            <td class="r num" data-amount>{r.amount}</td>
            <td class="r num" data-ratio>{r.ratio}</td>
          </tr>
        ))}
      </tfoot>
    )}
  </table>
</div>
<style>
  .table-scroll { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-small); min-width: 20rem; }
  caption { text-align: left; padding: var(--space-3) var(--space-4); color: var(--color-text-muted); caption-side: top; }
  th, td { padding: var(--space-3) var(--space-4); border-top: 1px solid var(--color-border); text-align: left; }
  thead th { background: var(--color-surface-2); font-weight: 600; }
  tbody th { font-weight: 400; }
  .r { text-align: right; }
  tfoot th, tfoot td { background: var(--color-primary-soft); font-weight: 700; color: var(--color-text); }
  .flash { animation: flash var(--duration-base) ease-out; }
  @keyframes flash { from { background: var(--color-primary-soft); } to { background: transparent; } }
  @media (prefers-reduced-motion: reduce) { .flash { animation: none; } }
</style>
