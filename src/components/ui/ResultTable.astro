---
/** 내역 표: 항목 / 금액 / 비율. 합계 행은 tfoot에서 강조한다. data-key로 스크립트가 값을 갱신한다. */
export interface ResultRow { key: string; label: string; amount: string; ratio: string; hidden?: boolean }
interface Props { caption: string; captionOut?: string; rows: ResultRow[]; totals?: ResultRow[] }
const { caption, captionOut, rows, totals = [] } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={`${caption} (가로로 스크롤할 수 있어요)`}>
  <table>
    <caption data-out={captionOut}>{caption}</caption>
    <thead>
      <tr><th scope="col">항목</th><th scope="col" class="r">금액</th><th scope="col" class="r">비율</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-row={r.key} hidden={r.hidden}>
          <th scope="row">{r.label}</th>
          <td class="r num" data-amount>{r.amount}</td>
          <td class="r num muted" data-ratio>{r.ratio}</td>
        </tr>
      ))}
    </tbody>
    {totals.length > 0 && (
      <tfoot>
        {totals.map((r) => (
          <tr data-row={r.key} hidden={r.hidden}>
            <th scope="row">{r.label}</th>
            <td class="r num" data-amount>{r.amount}</td>
            <td class="r num" data-ratio>{r.ratio}</td>
          </tr>
        ))}
      </tfoot>
    )}
  </table>
</div>
<style>
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: var(--fs-body-2); line-height: var(--lh-body-2); }
  caption { text-align: left; padding: 0 0 var(--space-2); color: var(--color-text-sub); caption-side: top; }
  th, td { padding: var(--space-3) 0; text-align: left; border: 0; }
  thead th { font-size: var(--fs-caption); line-height: var(--lh-caption); font-weight: 400; color: var(--color-text-tertiary); padding-top: var(--space-1); padding-bottom: var(--space-1); }
  tbody th { font-weight: 400; color: var(--color-text-sub); }
  td { padding-left: var(--space-3); }
  .r { text-align: right; }
  tfoot tr:first-child th, tfoot tr:first-child td { border-top: 1px solid var(--color-line); }
  tfoot th, tfoot td { font-weight: 700; color: var(--color-text); }
  .flash { animation: flash var(--duration-base) var(--ease); }
  @keyframes flash { from { background: var(--color-primary-weak); } to { background: transparent; } }
  @media (prefers-reduced-motion: reduce) { .flash { animation: none; } }
</style>
