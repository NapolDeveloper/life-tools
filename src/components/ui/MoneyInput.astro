---
import Field from './Field.astro';
import { num, koreanAmount } from '../../lib/format';
/**
 * 금액 입력. type="text" + inputmode="numeric", 천 단위 콤마(JS), 단위 고정 표시, 아래에 한글 읽기.
 * 테두리 없는 bg-sub 면, 포커스 시 2px primary 링. slot에는 빠른 입력 칩(Chips)을 넣는다.
 */
interface Props { id: string; name?: string; label: string; value: number; unit?: string; hint?: string }
const { id, name = id, label, value, unit = '원', hint } = Astro.props;
---
<Field id={id} label={label} hint={hint}>
  <div class="control">
    <input
      id={id}
      name={name}
      type="text"
      inputmode="numeric"
      autocomplete="off"
      value={num(value)}
      data-money
      aria-describedby={`${id}-reading ${hint ? `${id}-hint ` : ''}${id}-error`}
    />
    <span class="unit" aria-hidden="true">{unit}</span>
  </div>
  <p class="reading num" id={`${id}-reading`}>{koreanAmount(value)}</p>
  <slot />
</Field>
<style>
  .control { position: relative; border-radius: var(--radius-md); background: var(--color-bg-sub); }
  .control:focus-within { outline: 2px solid var(--color-primary); outline-offset: 0; }
  .control:has(input[aria-invalid='true']) { outline: 2px solid var(--color-danger); outline-offset: 0; }
  input {
    width: 100%; height: var(--btn-l); padding: 0 calc(var(--space-9) + var(--space-1)) 0 var(--space-4);
    background: transparent; color: var(--color-text); border: 0; border-radius: var(--radius-md); outline: 0;
    font-size: var(--fs-body-1); font-weight: 600; font-variant-numeric: tabular-nums; text-align: right;
  }
  .unit { position: absolute; right: var(--space-4); top: 50%; transform: translateY(-50%); color: var(--color-text-sub); font-size: var(--fs-body-1); pointer-events: none; }
  .reading { margin: var(--space-2) 0 var(--space-2); font-size: var(--fs-body-2); line-height: var(--lh-body-2); color: var(--color-primary); font-weight: 600; text-align: right; min-height: var(--lh-body-2); }
</style>
