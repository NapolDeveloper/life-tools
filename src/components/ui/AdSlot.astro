---
import { IS_PRODUCTION } from '../../lib/env';
/**
 * 광고 자리 (common-00 §1).
 * - production(승인 전): 아무것도 렌더링하지 않는다. 빈 슬롯도 노출하지 않는다.
 * - preview: 광고 코드 없이 회색 빈 자리 + "광고" 라벨, 높이 고정(CLS 방지).
 * 승인 후에는 이 컴포넌트 안에만 수동 광고 단위를 넣는다. 입력·결과 블록 안에는 배치하지 않는다.
 */
interface Props { slot?: 'after-result' | 'mid-content' }
const { slot = 'after-result' } = Astro.props;
---
{!IS_PRODUCTION && (
  <aside class="ad" data-ad-slot={slot} aria-label="광고 자리 (미리보기)">
    <p class="ad-label">광고</p>
    <div class="ad-box" />
  </aside>
)}
<style>
  .ad { margin: var(--space-6) 0; max-width: var(--content-max); }
  .ad-label { margin: 0 0 var(--space-1); font-size: var(--text-small); color: var(--color-text-muted); }
  .ad-box { height: 280px; background: var(--color-surface-2); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); }
</style>
