---
/**
 * 버튼 (site-03 §5). variant: primary(녹색 채움) / weak(연녹색 면) / grey(회색 면) / text.
 * size: l 56px(주 행동, 보통 block) / m 48px / s 36px. href가 있으면 링크로 렌더링한다. 페이지당 primary는 1개.
 */
interface Props {
  variant?: 'primary' | 'weak' | 'grey' | 'text';
  size?: 'l' | 'm' | 's';
  block?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}
const { variant = 'primary', size = 'm', block = false, href, type = 'button', class: extra = '', ...rest } = Astro.props;
const cls = `btn btn-${variant} btn-${size}${block ? ' btn-block' : ''} ${extra}`.trim();
---
{href ? (
  <a class={cls} href={href} {...rest}><slot /></a>
) : (
  <button class={cls} type={type} {...rest}><slot /></button>
)}
<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    border: 0; border-radius: var(--radius-lg);
    font-weight: 600; line-height: 1.2; text-decoration: none; cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease);
  }
  .btn:focus-visible { border-radius: var(--radius-lg); }
  .btn-l { height: var(--btn-l); padding: 0 var(--space-6); font-size: var(--fs-body-1); }
  .btn-m { height: var(--btn-m); padding: 0 var(--space-5); font-size: var(--fs-body-2); }
  .btn-s { height: var(--btn-s); padding: 0 var(--space-3); font-size: var(--fs-caption); border-radius: var(--radius-md); position: relative; }
  /* 36px 버튼도 터치 영역은 44px 이상 */
  .btn-s::after { content: ''; position: absolute; inset: -4px -2px; }
  .btn-block { display: flex; width: 100%; }
  .btn-primary { background: var(--color-primary); color: var(--color-on-primary); }
  .btn-weak { background: var(--color-primary-weak); color: var(--color-on-primary-weak); }
  .btn-grey { background: var(--color-bg-sub); color: var(--color-text); }
  .btn-text { background: transparent; color: var(--color-primary); }
  @media (hover: hover) {
    .btn-primary:hover { background: var(--color-primary-pressed); color: var(--color-on-primary); }
    .btn-weak:hover { background: color-mix(in srgb, var(--color-primary-weak), var(--color-primary) 10%); color: var(--color-on-primary-weak); }
    .btn-grey:hover { background: var(--color-line); color: var(--color-text); }
    .btn-text:hover { background: var(--color-primary-weak); color: var(--color-on-primary-weak); }
  }
  .btn:disabled, .btn[aria-disabled='true'] { opacity: 0.4; cursor: not-allowed; pointer-events: none; }
  .btn-primary:active { background: var(--color-primary-pressed); }
  @media (prefers-reduced-motion: no-preference) {
    .btn:active { transform: scale(var(--press-scale)); }
  }
</style>
