---
/** 버튼. primary / secondary(테두리) / ghost(텍스트), md(44px)·sm(36px). href가 있으면 링크로 렌더링한다. */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}
const { variant = 'primary', size = 'md', href, type = 'button', class: extra = '', ...rest } = Astro.props;
const cls = `btn btn-${variant} btn-${size} ${extra}`.trim();
---
{href ? (
  <a class={cls} href={href} {...rest}><slot /></a>
) : (
  <button class={cls} type={type} {...rest}><slot /></button>
)}
<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: var(--touch-min); padding: 0 var(--space-4);
    border: 1px solid transparent; border-radius: var(--radius-sm);
    font-weight: 600; font-size: var(--text-body); line-height: 1.2;
    text-decoration: none; cursor: pointer;
    transition: background-color var(--duration-fast), border-color var(--duration-fast), color var(--duration-fast);
  }
  .btn-sm { min-height: var(--touch-sm); padding: 0 var(--space-3); font-size: var(--text-small); }
  .btn-primary { background: var(--color-primary); color: var(--color-on-primary); }
  .btn-primary:hover { background: var(--color-primary-hover); color: var(--color-on-primary); }
  .btn-secondary { background: var(--color-surface); color: var(--color-text); border-color: var(--color-border-strong); }
  .btn-secondary:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .btn-ghost { background: transparent; color: var(--color-primary); }
  .btn-ghost:hover { background: var(--color-primary-soft); color: var(--color-primary-hover); }
</style>
