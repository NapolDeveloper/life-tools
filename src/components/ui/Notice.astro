---
import Info from '../icons/Info.astro';
import TriangleAlert from '../icons/TriangleAlert.astro';
/** 안내 박스: bg-sub 면 + 아이콘 + 라벨. 색만으로 구분하지 않고, 왼쪽 굵은 선 장식은 쓰지 않는다. */
interface Props { variant?: 'info' | 'warning'; title?: string }
const { variant = 'info', title } = Astro.props;
const label = title ?? (variant === 'warning' ? '주의' : '안내');
---
<aside class={`notice notice-${variant}`}>
  <p class="notice-title">
    {variant === 'warning' ? <TriangleAlert /> : <Info />}
    <strong>{label}</strong>
  </p>
  <div class="notice-body"><slot /></div>
</aside>
<style>
  .notice { background: var(--color-bg-sub); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); margin: 0 0 var(--space-4); font-size: var(--fs-body-2); line-height: var(--lh-body-2); }
  .notice-title { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-2); color: var(--color-text); }
  .notice-title :global(svg) { color: var(--color-primary); }
  .notice-warning .notice-title :global(svg) { color: var(--color-warning); }
  .notice-body { color: var(--color-text-sub); }
  .notice-body :global(p) { margin: 0 0 var(--space-2); }
  .notice-body :global(p:last-child) { margin-bottom: 0; }
</style>
