---
import Info from '../icons/Info.astro';
import TriangleAlert from '../icons/TriangleAlert.astro';
/** 안내 박스. 색만으로 구분하지 않도록 아이콘과 라벨을 함께 둔다. */
interface Props { variant?: 'info' | 'warning'; title?: string }
const { variant = 'info', title } = Astro.props;
const label = title ?? (variant === 'warning' ? '주의' : '안내');
---
<aside class={`notice notice-${variant}`}>
  <p class="notice-title">
    {variant === 'warning' ? <TriangleAlert /> : <Info />}
    <strong>{label}</strong>
  </p>
  <div class="notice-body"><slot /></div>
</aside>
<style>
  .notice { background: var(--color-surface-2); border-left: 4px solid var(--color-info); border-radius: var(--radius-sm); padding: var(--space-3) var(--space-4); margin: 0 0 var(--space-4); font-size: var(--text-small); line-height: var(--text-small-lh); }
  .notice-warning { border-left-color: var(--color-warning); }
  .notice-title { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-1); color: var(--color-info); }
  .notice-warning .notice-title { color: var(--color-warning); }
  .notice-body :global(p) { margin: 0 0 var(--space-2); }
  .notice-body :global(p:last-child) { margin-bottom: 0; }
</style>
