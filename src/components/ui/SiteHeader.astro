---
import { SITE_NAME, CATEGORIES } from '../../config';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label={`${SITE_NAME} 홈`}>{SITE_NAME}</a>
    <nav aria-label="주요 메뉴">
      <ul>
        {CATEGORIES.map((c) => (
          <li><a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header { background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .inner {
    max-width: var(--wide-max); margin: 0 auto; padding: 0 var(--gutter);
    min-height: calc(var(--touch-min) + var(--space-3));
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
  }
  .brand { font-size: var(--text-h3); font-weight: 800; color: var(--color-primary); text-decoration: none; min-height: var(--touch-min); display: inline-flex; align-items: center; }
  ul { list-style: none; display: flex; gap: var(--space-1); margin: 0; padding: 0; }
  li { margin: 0; }
  nav a {
    display: inline-flex; align-items: center; min-height: var(--touch-min); padding: 0 var(--space-3);
    color: var(--color-text); text-decoration: none; font-weight: 600; font-size: var(--text-small); border-radius: var(--radius-sm);
  }
  nav a:hover { color: var(--color-primary); background: var(--color-primary-soft); }
  nav a[aria-current='page'] { color: var(--color-primary); background: var(--color-primary-soft); }
  @media (min-width: 768px) { nav a { font-size: var(--text-body); } }
</style>
