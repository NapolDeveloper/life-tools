---
import { SITE_NAME, CATEGORIES } from '../../config';
const path = Astro.url.pathname;
---
<header class="site-header" data-site-header>
  <div class="inner">
    <a class="brand" href="/" aria-label={`${SITE_NAME} 홈`}>{SITE_NAME}</a>
    <nav aria-label="주요 메뉴">
      <ul>
        {CATEGORIES.map((c) => (
          <li><a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  /* 하단 경계는 스크롤했을 때만(.scrolled, BaseLayout의 작은 스크립트가 토글) */
  .site-header { position: sticky; top: 0; z-index: 10; background: var(--color-bg); border-bottom: 1px solid transparent; transition: border-color var(--duration-fast) var(--ease); }
  .site-header.scrolled { border-bottom-color: var(--color-line); }
  .inner {
    max-width: calc(var(--content-max) + var(--gutter) * 2); margin: 0 auto; padding: 0 var(--gutter);
    height: var(--btn-m);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
  }
  .brand { font-size: var(--fs-title-3); line-height: var(--lh-title-3); font-weight: 700; letter-spacing: var(--tracking-title); color: var(--color-primary); text-decoration: none; min-height: var(--touch-min); display: inline-flex; align-items: center; }
  ul { list-style: none; display: flex; gap: 0; margin: 0 calc(var(--space-3) * -1) 0 0; padding: 0; }
  li { margin: 0; }
  nav a {
    display: inline-flex; align-items: center; min-height: var(--touch-min); padding: 0 var(--space-3);
    color: var(--color-text-sub); text-decoration: none; font-weight: 600; font-size: var(--fs-body-2); border-radius: var(--radius-md);
  }
  nav a:hover { color: var(--color-text); }
  nav a[aria-current='page'] { color: var(--color-primary); }
</style>
